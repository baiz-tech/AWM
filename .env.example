# Template for environment variables used by the launcher and the task modules.
#
# Copy to .env and fill in locally. Do NOT put real credentials or
# machine-specific values into a committed file -- record those in
# docs/manual/resource.md instead.

# ---- distributed runtime overrides (see docs/manual/resource.md section 6) ----
NNODES=1
NODE_RANK=0
MASTER_ADDR=127.0.0.1
MASTER_PORT=29500
NPROC_PER_NODE=8
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# ---- data and weights ----
# Physion++ extracted root.
PHYSION_ROOT=/data/ABDUCTIVE-WORLD/physion_v2/extracted
# CLEVRER raw root.
CLEVRER_ROOT=/data/shared/datasets/CLEVRER
# EPIC-KITCHENS-100 processed root (not present on every machine).
EK100_ROOT=/data/shared/datasets/EPIC-KITCHENS-processed_v1
# Frozen V-JEPA 2 ViT-H encoder/predictor weights.
VJEPA2_ENCODER_CHECKPOINT=/data/ABDUCTIVE-WORLD/pretrain/checkpoints/vith.pt
# Orca-4B weights used by the Orca baselines.
ORCA_ROOT=/data/shared_model/Orca-4B

# ---- interpreter ----
# Absolute path to the interpreter used by the legacy shell helpers.
PYTHON_BIN=/data/shared/envs/vjepa2-312/bin/python
